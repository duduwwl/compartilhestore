# Copie este arquivo como .env e preencha somente no servidor.
PORT=4173
NODE_ENV=production

# Melhor Envio — token privado e ambiente de produção.
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_SANDBOX=false
MELHOR_ENVIO_USER_AGENT=Compartilhe Store (seu-email@dominio.com.br)

# Mercado Pago — nunca coloque o access token em checkout.js ou em HTML.
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ACCESS_TOKEN=
